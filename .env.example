# Copy this file to .env and fill in your own values. Never commit .env.

LOG_LEVEL=INFO

# Chat model: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here   # only if LLM_PROVIDER=openai (CHAT_MODEL=gpt-4o-mini)

# Embeddings (Voyage AI, recommended by Anthropic; free tier available)
EMBEDDING_MODEL=voyage-3.5-lite
VOYAGE_API_KEY=pa-your-key-here

# Postgres with the pgvector extension (Neon or Supabase free tier)
DATABASE_URL=postgresql://user:password@host:5432/dbname
